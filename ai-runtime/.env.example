PORT=3001

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=0123456789abcdef0123456789abcdef

OPENAI_API_KEY=

LIVEKIT_ROOM=test-room
LARAVEL_URL=http://backend
# Do NOT set SIP_LAN_IP here - it's injected by docker-compose.yml from
# the top-level .env (the single source of truth now; see
# infra/render-config.sh). Set it there instead.

BUSINESS_SLUG=abc-contractors
RIME_API_KEY=
TTS_PROVIDER=openai

LLM_PROVIDER=openai
# Optional: a second LLM provider (openai/groq/fireworks/openrouter/gemini/
# realtime) to permanently switch a call to if LLM_PROVIDER's own bounded
# retry still exhausts and throws (e.g. Groq's flat 8000 TPM ceiling) -
# see FallbackLLM.ts. Off (no fallback) when unset.
# LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RUNTIME_API_KEY=
